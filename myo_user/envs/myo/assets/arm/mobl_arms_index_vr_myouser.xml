<mujoco model="MoBL Arms Index model for VR-Controller raycast tasks">

    <include file="../../../../simhive/uitb_sim/assets/mobl_arms_index_assets.xml"/>
    <compiler meshdir='../../../../simhive/uitb_sim/'
              texturedir='../../../../simhive/uitb_sim/'/>

    <asset>
        <mesh name="controller-right" file="controller-right.stl"/>
        <!-- <mesh name="controller-left" file="controller-left.stl"/> -->
    </asset>

    <worldbody>
        <body name="full_body" pos="0 0 1">
            <include file="../../../../simhive/uitb_sim/assets/mobl_arms_index_vr_body.xml"/>
        </body>

        <body name="target" pos="0.5 0.14 1.1">
            <geom name="target_sphere" type="sphere" size="0.05" rgba="0.1 0.8 0.1 1"/>
            <!-- <site name="fingertip_target" size="0.025" rgba="0.1 0.8 0.1 1" pos="0.5 0 0.8"/> -->
        </body>

        <light name="scene_light" directional="true" castshadow="false"
               cutoff="4" exponent="20" diffuse="1 1 1" specular="0 0 0"
               pos="0.5 0.5 3.0"/>
        <body name="fixed-eye" pos="0 0 1.2" quat="0.583833 0.399104 -0.399421 -0.583368">
            <geom name="fixed-eye" quat="0.7106 0.25537 0.616985 0.221728"
                  type="mesh" rgba="1 1 1 0" mesh="eye"/>
            <camera name="fixed-eye" pos="0 0 0" fovy="120"/>
        </body>
        <body name="side_camera" pos="0.25 -0.27 1.0" euler="1.5708 0 0">
            <camera name="side_camera" pos="0 0 1.2" fovy="70"/>
        </body>
        <body name="head_on_camera" pos="1.5 0.0 1.0" euler="1.5708 1.5708 0.0">
            <camera name="head_on_camera" pos="0 0 12" fovy="10"/>
        </body>
    </worldbody>

</mujoco>